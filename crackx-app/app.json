{
  "expo": {
    "name": "CrackX",
    "slug": "crackx-app",
    "version": "1.0.7",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "jsEngine": "hermes",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#2563eb"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "CrackX needs your location to accurately report road damages and route complaints to the correct municipal zone.",
        "NSCameraUsageDescription": "CrackX needs camera access to capture photos of road damages.",
        "NSPhotoLibraryUsageDescription": "CrackX needs access to your photo library to select damage photos."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2563eb"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.crackx.app",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "enableDangerousExperimentalLeanBuilds": true,
      "bundleIdentifier": "com.crackx.app",
      "versionCode": 8
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "pwa": {
        "name": "CrackX - Road Condition Management",
        "shortName": "CrackX",
        "themeColor": "#2563eb",
        "backgroundColor": "#ffffff",
        "display": "standalone",
        "orientation": "portrait"
      }
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "CrackX needs your location to accurately report road damages and route complaints to the correct municipal zone."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "CrackX needs access to your photo library to select damage photos."
        }
      ],
      [
        "@rnmapbox/maps",
        {
          "RNMapboxMapsImpl": "mapbox"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "buildToolsVersion": "35.0.0",
            "ndkVersion": "26.1.10909125",
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "-keep class com.mapbox.** { *; }\n-keep class com.rnmapbox.** { *; }\n-dontwarn com.mapbox.**",
            "enableMinifyInReleaseBuilds": true,
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "cc19c5ac-6bc6-48ed-b574-833a1ad6f806"
      }
    }
  }
}
